    "vue-router": "^5.4.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "~6.0.3",
    "vite": "~8.3.6",
    "vue-tsc": "^3.3.14"
  }
}
